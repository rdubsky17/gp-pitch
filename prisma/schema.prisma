generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model users {
  id       Int      @id @default(autoincrement())
  username String   @db.VarChar(100)
  email    String   @unique @db.VarChar(100)
  password String   @db.VarChar(100)
}